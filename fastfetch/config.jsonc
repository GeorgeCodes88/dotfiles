{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/home/minty/.config/fastfetch/gorou.png",
    "width": 32,
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "󰌢 OS",
      "keyColor": "#fb4934",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "#fabd2f",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#b8bb26",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "#8ec07c",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#83a598",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "#d3869b",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#fe8019",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "#b8bb26",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "#fabd2f",
      "outputColor": "#fbf1c7",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "#83a598",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "de",
      "key": "󰧨 DE",
      "keyColor": "#d3869b",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "wm",
      "key": "󰖲 WM",
      "keyColor": "#8ec07c",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme",
      "keyColor": "#fb4934",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "localip",
      "key": "󰩟 Network",
      "keyColor": "#83a598",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "media",
      "key": "󰎆 Now Playing",
      "keyColor": "#d3869b",
      "outputColor": "#fbf1c7"
    },
    {
      "type": "datetime",
      "key": "󰥔 Time",
      "keyColor": "#8ec07c",
      "outputColor": "#ebdbb2"
    },

    "break"
  ]
}
